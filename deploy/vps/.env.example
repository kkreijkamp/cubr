# /opt/cubr/.env on the production VM (mode 600). Never commit real values.
# `deploy/vps/deploy.sh init` creates it with fresh random secrets; deploy.sh sets CUBR_VERSION.

# Image tag in Artifact Registry (australia-southeast1-docker.pkg.dev/cubr-app/cubr/<svc>:<tag>)
CUBR_VERSION=1.0.82

# Postgres password (only used inside the compose network; hex keeps it URL-safe)
POSTGRES_PASSWORD=
# HS256 signing key for login tokens: changing it signs everyone out
JWT_SECRET=
# Shared secret for /internal/* calls between services (X-Internal-Token)
INTERNAL_API_TOKEN=

# Token of the Cloudflare Tunnel "cubr" (cloudflared runs `tunnel run` with it)
CLOUDFLARE_TUNNEL_TOKEN=

# Resend API key for password-reset emails (domain cubr.dev); unset = emails are logged, not sent
RESEND_API_KEY=
# Ko-fi webhook verification token (ko-fi.com > More > API > Webhooks); unset = the webhook refuses all
KOFI_VERIFICATION_TOKEN=
