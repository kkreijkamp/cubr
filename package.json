{
  "name": "cubr",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "description": "cubr - a cloud-native speedcubing timer on Kubernetes",
  "workspaces": [
    "packages/*",
    "services/*",
    "jobs/*"
  ],
  "scripts": {
    "build:svc": "node scripts/build-service.mjs",
    "build:all": "for d in services/* jobs/seed; do node scripts/build-service.mjs $d || exit 1; done",
    "test": "vitest run",
    "test:integration": "bash scripts/test-integration.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "vitest": {
      "vite": "^7.3.7"
    }
  }
}
