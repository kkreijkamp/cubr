# Supply-chain guard (to-do "Supply-chain guards", 2026-11-26): no install scripts from dependencies.
# The 2025 npm worms spread through install scripts; today only esbuild and fsevents have one, and
# both work without it (their binaries come as platform packages). A new dependency that needs its
# script has to say why: run it by hand with `npm rebuild <package>`.
# (min-release-age waits for npm 11.10+: npm 10 doesn't know it. Until then, update with
# `npm install --before <a week ago>`, as the v1.4.26-v1.4.29 updates did.)
ignore-scripts=true
