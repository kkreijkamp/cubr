# nginx config for the cubetype web container (rendered by envsubst at container start).
# Serves the React SPA; API traffic never reaches this container — the Ingress (cloud) or the
# gateway (local) routes /api/* and /socket.io to the backend services.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml text/plain;

  # liveness / readiness probes
  location = /healthz {
    access_log off;
    default_type application/json;
    return 200 '{"status":"ok"}';
  }
  location = /readyz {
    access_log off;
    default_type application/json;
    return 200 '{"status":"ready"}';
  }

  # which pod/version served this request — used by the in-app cluster status page
  location = /_info {
    access_log off;
    default_type application/json;
    add_header Cache-Control "no-store" always;
    add_header X-Served-By $hostname always;
    add_header X-Service "web@${APP_VERSION}" always;
    return 200 '{"service":"web","version":"${APP_VERSION}","pod":"$hostname","node":"${NODE_NAME}","startedAt":null,"uptimeSec":null,"deps":{}}';
  }

  # /api/* and /internal/* belong to the services. Whatever still reaches this container (an
  # unrouted /api path, or /internal/* via the Ingress default backend) gets a JSON 404 instead of
  # the SPA's index.html, so API clients never mistake HTML for data.
  location ^~ /internal/ {
    default_type application/json;
    return 404 '{"error":{"code":"NOT_FOUND","message":"Not found"}}';
  }
  location ^~ /api/ {
    default_type application/json;
    return 404 '{"error":{"code":"NOT_FOUND","message":"Not found"}}';
  }

  # hashed build assets can be cached forever
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Served-By $hostname always;
    try_files $uri =404;
  }

  # SPA: every other path serves index.html (client-side routing); never cache it so a rollout
  # is visible on the next page load
  location / {
    add_header Cache-Control "no-cache" always;
    add_header X-Served-By $hostname always;
    add_header X-Service "web@${APP_VERSION}" always;
    try_files $uri $uri/ /index.html;
  }
}
